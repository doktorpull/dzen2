# ============================================================
# Основные настройки сервера и авторизации
# ============================================================
# Порт: 3000 для локальной среды разработки, 8003 для Docker/VPS
PORT=8003
APP_URL="http://igrovoikompas.ru/dzen/"
DATA_DIR="./data"

# Логин и пароль для входа в веб-админку /dzen/
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_strong_password"
SESSION_SECRET="replace_with_random_64_char_secret"

# ============================================================
# Провайдеры ИИ (ключи хранятся только на сервере)
# ============================================================
# Google Gemini (по умолчанию: текст, Google Search grounding, embeddings, изображения)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Опциональные внешние текстовые и мультимодальные провайдеры
# Z.ai (Zhipu GLM + CogView-4)
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Ollama (локальный или удалённый сервер, для Docker на VPS: http://host.docker.internal:11434/v1)
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_API_KEY=""

# Популярные облачные провайдеры
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
GROQ_API_KEY=""
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
MISTRAL_API_KEY=""
XAI_API_KEY=""
TOGETHER_API_KEY=""
ANTHROPIC_API_KEY=""
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""
CUSTOM_OPENAI_API_KEY=""

# Опциональный внешний генератор изображений (Kandinsky / FusionBrain)
KANDINSKY_API_KEY=""
KANDINSKY_SECRET_KEY=""

# ============================================================
# Опциональная публикация через Telegram (@zen_sync_bot)
# По умолчанию тумблер в админке выключен
# ============================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
